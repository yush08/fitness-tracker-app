rules_version = '2';

// Security rules for GoFit.
//
// The whole app is scoped to `users/{uid}/…`, and the only principal that may
// touch a user's tree is that same authenticated user. Nothing is world- or
// cross-user readable. Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in user reading/writing their own document.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // All per-user subcollections (meals, activities, …) inherit the same
      // owner-only rule.
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Anything not matched above is denied by default.
  }
}
